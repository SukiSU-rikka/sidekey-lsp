<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:description="@string/xposed_desc"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.SideKey">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- libxposed service：LSPosed 通过它把框架服务推给本 App -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:directBootAware="true"
            android:exported="true"
            tools:replace="android:authorities,android:exported,android:directBootAware" />

        <!-- 只有系统(持有 DEVICE_POWER)能发：以 root 执行 Shell 动作 -->
        <receiver
            android:name=".CmdReceiver"
            android:exported="true"
            android:permission="android.permission.DEVICE_POWER">
            <intent-filter>
                <action android:name="com.sidekey.lsp.RUN_SHELL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
